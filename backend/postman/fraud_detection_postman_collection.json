						"body": {
							"mode": "raw",
							"raw": "{\n  \"numeroCuentaOrigen\": \"CUENTA-FANTASMA-999\",\n  \"numeroCuentaDestino\": \"CTA-002-998811\",\n  \"monto\": 100.00,\n  \"moneda\": \"PEN\",\n  \"canal\": \"APP\",\n  \"tipoTransaccion\": \"TRANSFERENCIA\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/transacciones",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"transacciones"
							]
						},
						"description": "Valida error de negocio cuando la cuenta origen no existe en el sistema bancario."
					},
					"response": []
				}
			]
		},
		{
			"name": "03. Alertas Antifraude (Analista)",
			"item": [
				{
					"name": "Listar Alertas de Fraude Generadas",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{authToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/alertas?estado=GENERADA&prioridad=CRITICA",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"alertas"
							],
							"query": [
								{
									"key": "estado",
									"value": "GENERADA"
								},
								{
									"key": "prioridad",
									"value": "CRITICA"
								}
							]
						},
						"description": "Obtiene la bandeja de alertas pendientes de atención para los analistas de seguridad."
					},
					"response": []
				},
				{
					"name": "Consultar Detalle de Alerta por ID",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{authToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/alertas/{{alertaId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"alertas",
								"{{alertaId}}"
							]
						},
						"description": "Retorna el detalle completo de la alerta, incluyendo el desglose de reglas y puntuaciones."
					},
					"response": []
				},
				{
					"name": "Cambiar Estado de Alerta (Asignar / En Revisión)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{authToken}}",
									"type": "string"
								}
							]
						},
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"estado\": \"EN_REVISION\",\n  \"comentario\": \"Analista iniciando análisis de patrones de IP y dispositivo.\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/alertas/{{alertaId}}/estado",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"alertas",
								"{{alertaId}}",
								"estado"
							]
						},
						"description": "Actualiza el ciclo de vida de la alerta de fraude."
					},
					"response": []
				}
			]
		},
		{
			"name": "04. Casos de Investigación Formal",
			"item": [
				{
					"name": "Abrir Caso Formal de Investigación",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200 || pm.response.code === 201) {",
									"    var json = pm.response.json();",
									"    if (json.idCaso) {",
									"        pm.collectionVariables.set('casoId', json.idCaso);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{authToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"codigoAlerta\": \"{{alertaId}}\",\n  \"motivoApertura\": \"Transacción sospechosa en horario no habitual con score crítico.\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/casos",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"casos"
							]
						},
						"description": "Abre un caso formal para investigación de fraude según la alerta originada."
					},
					"response": []
				},
				{
					"name": "Registrar Evento en Bitácora del Caso",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{authToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"tipoEvento\": \"EVIDENCIA\",\n  \"comentario\": \"Titular contactado vía telefónica; confirma que no autorizó la operación desde el exterior.\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/casos/{{casoId}}/historial",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"casos",
								"{{casoId}}",
								"historial"
							]
						},
						"description": "Añade un registro cronológico al historial del caso para auditoría."
					},
					"response": []
				},
				{
					"name": "Cerrar Caso con Dictamen Final (Fraude Confirmado)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{authToken}}",
									"type": "string"
								}
							]
						},
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"resultado\": \"FRAUDE_CONFIRMADO\",\n  \"comentarioCierre\": \"Fraude verificado con el cliente. Dispositivo y credenciales comprometidas. Cuenta asegurada preventivamente.\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/casos/{{casoId}}/cerrar",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"casos",
								"{{casoId}}",
								"cerrar"
							]
						},
						"description": "Cierra formalmente el caso registrando la conclusión para el modelo analítico y auditoría."
					},
					"response": []
				}
			]
		}
	]
}
