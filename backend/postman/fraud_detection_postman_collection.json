							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"transacciones"
							]
						},
						"description": "Escenario 11.1 del PDF: Transferencia de monto normal (S/ 250), dispositivo conocido, beneficiario habitual, horario diurno en Perú. Se evalúa con score < 30 y resulta APROBADA."
					},
					"response": []
				},
				{
					"name": "2. No Happy Path A - Fraude Crítico (Dispositivo Nuevo, País Atípico, Monto Alto)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 201 Created', function () {",
									"    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
									"});",
									"pm.test('Decisión es BLOQUEAR o RETENER con Riesgo CRÍTICO (> 70)', function () {",
									"    var json = pm.response.json();",
									"    pm.expect(json.evaluacion.nivelRiesgo).to.be.oneOf(['ALTO', 'CRITICO']);",
									"    pm.expect(json.evaluacion.decision).to.be.oneOf(['BLOQUEAR', 'RETENER']);",
									"    pm.expect(json.evaluacion.score).to.be.above(70);",
									"    pm.collectionVariables.set('transaccionId', json.codigoTransaccion);",
									"});"
								],
								"type": "text/javascript"
							}
						}
