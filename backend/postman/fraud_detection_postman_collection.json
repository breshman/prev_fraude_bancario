							"raw": "{\n  \"numeroCuentaOrigen\": \"CTA-001-445522\",\n  \"numeroCuentaDestino\": \"CTA-002-998811\",\n  \"monto\": -50.00,\n  \"moneda\": \"PEN\",\n  \"canal\": \"APP\",\n  \"tipoTransaccion\": \"TRANSFERENCIA\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/transacciones",
