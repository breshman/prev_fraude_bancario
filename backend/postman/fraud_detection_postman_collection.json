		{
			"name": "01. Autenticación (Auth & JWT)",
			"item": [
				{
					"name": "Login Analista de Fraude",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.token) {",
									"        pm.collectionVariables.set('authToken', jsonData.token);",
									"        console.log('JWT Token guardado:', jsonData.token);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nombreUsuario\": \"analista_seguridad\",\n  \"password\": \"Admin1234#\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"login"
							]
						},
						"description": "Autentica al analista y extrae automáticamente el JWT a la variable {{authToken}}."
					},
					"response": []
				}
			]
		},
		{
			"name": "02. Transacciones (Scoring & Detección)",
			"item": [
				{
					"name": "1. Happy Path - Transacción Legítima (Bajo Riesgo / Aprobada)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200 or 201', function () {",
									"    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
									"});",
									"pm.test('Decisión es APROBADA y Score es Bajo', function () {",
									"    var json = pm.response.json();",
									"    pm.expect(json.estado).to.eql('APROBADA');",
									"    pm.expect(json.evaluacion.nivelRiesgo).to.eql('BAJO');",
									"    pm.expect(json.evaluacion.score).to.be.below(30);",
									"    if (json.codigoTransaccion) {",
									"        pm.collectionVariables.set('transaccionId', json.codigoTransaccion);",
									"    }",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "X-Correlation-Id",
								"value": "corr-test-happy-001"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"numeroCuentaOrigen\": \"CTA-001-445522\",\n  \"numeroCuentaDestino\": \"CTA-002-998811\",\n  \"monto\": 250.00,\n  \"moneda\": \"PEN\",\n  \"canal\": \"APP\",\n  \"tipoTransaccion\": \"TRANSFERENCIA\",\n  \"codigoPais\": \"PE\",\n  \"direccionIp\": \"190.235.12.44\",\n  \"huellaDispositivo\": \"device-fingerprint-habitual-01\",\n  \"latitud\": -12.046374,\n  \"longitud\": -77.042793\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/transacciones",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"transacciones"
							]
						},
						"description": "Escenario 11.1 de la especificación técnica: Transferencia de monto normal (S/ 250), dispositivo conocido, beneficiario habitual, horario diurno en Perú. Debe evaluarse con score < 30 y ser APROBADA."
					},
					"response": []
				},
				{
					"name": "2. No Happy Path A - Fraude Crítico (Dispositivo Nuevo, País Atípico, Monto Alto)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200 or 201 (Decisión de negocio)', function () {",
									"    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
									"});",
									"pm.test('Decisión es BLOQUEAR o RETENER con Riesgo CRÍTICO', function () {",
									"    var json = pm.response.json();",
									"    pm.expect(json.evaluacion.nivelRiesgo).to.be.oneOf(['ALTO', 'CRITICO']);",
									"    pm.expect(json.evaluacion.decision).to.be.oneOf(['BLOQUEAR', 'RETENER']);",
									"    pm.expect(json.evaluacion.score).to.be.above(70);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "X-Correlation-Id",
								"value": "corr-test-fraud-002"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"numeroCuentaOrigen\": \"CTA-001-445522\",\n  \"numeroCuentaDestino\": \"CTA-999-DESTINO-DESCONOCIDO\",\n  \"monto\": 18500.00,\n  \"moneda\": \"PEN\",\n  \"canal\": \"WEB\",\n  \"tipoTransaccion\": \"TRANSFERENCIA\",\n  \"codigoPais\": \"RU\",\n  \"direccionIp\": \"95.173.136.72\",\n  \"huellaDispositivo\": \"fingerprint-desconocido-moscu-99\",\n  \"latitud\": 55.755826,\n  \"longitud\": 37.617300\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/transacciones",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"transacciones"
							]
						},
						"description": "Escenario 11.2 del PDF: Transferencia de S/ 18,500 a las 03:12 de la madrugada desde Rusia, dispositivo nunca visto, beneficiario nuevo. Se disparan RF001, RF002, RF003, RF004, RF007 y genera Alerta Crítica."
					},
					"response": []
				},
				{
					"name": "3. No Happy Path B - Monto Inválido (Menor o Igual a Cero)",
